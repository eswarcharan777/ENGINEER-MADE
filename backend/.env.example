GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:3000

# Comma-separated verified Firebase Authentication emails allowed to use the
# admin portal. Prefer the Firebase custom claim `admin: true` in production.
ADMIN_EMAILS=admin@example.com

# Server-side only. In Vercel paste the complete service-account JSON as this
# environment variable's value. Never expose it through a REACT_APP_* variable.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative for Application Default Credentials / Firestore emulator usage.
FIREBASE_PROJECT_ID=
# Required for administrator image/document uploads, for example:
# your-project-id.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# Required for the five-language online compiler. Point this at your own
# sandboxed Piston-compatible runner's /api/v2/execute endpoint.
CODE_RUNNER_URL=
CODE_RUNNER_TOKEN=
